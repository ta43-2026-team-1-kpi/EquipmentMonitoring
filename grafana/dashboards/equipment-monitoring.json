          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "equipment-monitoring-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT w.\"CreatedAtUtc\" AS \"Час\", e.\"Name\" AS \"Обладнання\", e.\"SerialNumber\" AS \"Серійний номер\", w.\"MeasurementType\" AS \"Показник\", w.\"ActualValue\" AS \"Значення\", w.\"LimitValue\" AS \"Межа\", w.\"Unit\" AS \"Од.\", w.\"BreachType\" AS \"Порушення\", w.\"ThresholdScope\" AS \"Межа задана\", w.\"Status\" AS \"Статус\" FROM \"Warnings\" w JOIN \"Equipment\" e ON e.\"Id\" = w.\"EquipmentId\" WHERE $__timeFilter(w.\"CreatedAtUtc\") AND ('__all' IN ($equipment) OR w.\"EquipmentId\"::text IN ($equipment)) ORDER BY w.\"CreatedAtUtc\" DESC LIMIT 50"
        }
