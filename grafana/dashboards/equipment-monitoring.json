          "rawSql": "SELECT e.\"Name\" AS equipment, count(*) AS warnings FROM \"Warnings\" w JOIN \"Equipment\" e ON e.\"Id\" = w.\"EquipmentId\" WHERE w.\"Status\" = 'Active' AND ('__all' IN ($equipment) OR w.\"EquipmentId\"::text IN ($equipment)) GROUP BY e.\"Name\" ORDER BY warnings DESC, e.\"Name\""
