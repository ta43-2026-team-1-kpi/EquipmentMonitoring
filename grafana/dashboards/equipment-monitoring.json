            "uid": "equipment-monitoring-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(m.\"MeasuredAtUtc\", $__interval), e.\"Name\" AS metric, avg(m.\"Value\") AS value FROM \"Measurements\" m JOIN \"Equipment\" e ON e.\"Id\" = m.\"EquipmentId\" WHERE $__timeFilter(m.\"MeasuredAtUtc\") AND m.\"Type\" = 'Temperature' AND ('__all' IN ($equipment) OR m.\"EquipmentId\"::text IN ($equipment)) GROUP BY 1, 2 ORDER BY 1"
